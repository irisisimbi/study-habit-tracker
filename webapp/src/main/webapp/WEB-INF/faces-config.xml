<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_3.xsd"
              version="2.3">

    <!-- Custom validator: type 2 of the three validation types required by the assignment -->
    <validator>
        <validator-id>studySessionDurationValidator</validator-id>
        <validator-class>com.auca.studytracker.validator.StudySessionDurationValidator</validator-class>
    </validator>

    <validator>
        <validator-id>subjectNameValidator</validator-id>
        <validator-class>com.auca.studytracker.validator.SubjectNameValidator</validator-class>
    </validator>

    <application>
        <resource-bundle>
            <base-name>messages</base-name>
            <var>msg</var>
        </resource-bundle>
    </application>

</faces-config>
